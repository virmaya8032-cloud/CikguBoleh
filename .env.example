# ==== CikguBoleh — contoh konfigurasi ====
# Salin fail ini kepada .env.local (pembangunan) atau set di Vercel (produksi).

# ---- SUDAH ADA di Vercel anda ----
# URL aplikasi (SEO, sitemap, OG tags, pautan email)
NEXT_PUBLIC_APP_URL=https://cikguboleh.vercel.app

# Postgres (Supabase). Tanpa ini, feedback & analitik guna storan in-memory (demo, tidak kekal).
# Produksi: gunakan Supabase connection pooler (port 6543) untuk serverless.
# RAHSIA — jangan letak dalam NEXT_PUBLIC_*.
DATABASE_URL=

# ---- PERLU DITAMBAH untuk Panel Pentadbir ----
# Email admin untuk log masuk panel.
ADMIN_EMAIL=admin@cikguboleh.my
# Hash bcrypt kata laluan admin (BUKAN plaintext). Jana dengan:
#   node scripts/generate-admin-password.mjs "KataLaluanAnda"
# Salin nilai hash sahaja ke sini. Lalai pembangunan = "admin123".
ADMIN_PASSWORD_HASH=
# Rahsia untuk menandatangani cookie sesi admin (rentetan rawak panjang).
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# ---- Email (pilihan — Resend) ----
# Tanpa ini, feedback tetap disimpan; auto-reply & balasan admin dilangkau.
RESEND_API_KEY=
EMAIL_FROM=CikguBoleh <no-reply@domain-anda.my>

# ---- AI (pilihan) ----
# Tanpa ini, alat AI guna Mode Demo (output templat berfungsi penuh).
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-opus-4-8

# ---- Analitik ----
NEXT_PUBLIC_ANALYTICS_ENABLED=true
